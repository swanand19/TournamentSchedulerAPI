<?xml version="1.0" encoding="utf-8"?>
<!--
  Used only when the API runs under IIS; `dotnet run` ignores this file. `dotnet publish` fills in
  the process path and arguments and keeps everything else here.

  Hosting__RedirectToHttps=false: the home-network test site serves phones over plain HTTP, and a
  phone can't follow a redirect to an HTTPS address the laptop has no trusted certificate for.
  Remove it once the API is hosted with a real certificate.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\TournamentScheduler.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="Hosting__RedirectToHttps" value="false" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
